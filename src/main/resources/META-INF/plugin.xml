<idea-plugin>
    <id>dev.knthmn.herdr-idea-plugin</id>
    <name>Herdr</name>
    <vendor>knthmn</vendor>
    <description><![CDATA[
        <p>Shows herdr-core terminals of the current project and opens them in the IDE terminal.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
                id="Herdr"
                anchor="right"
                icon="/icons/herdr.svg"
                factoryClass="dev.knthmn.herdr.ui.HerdrToolWindowFactory"/>
        <fileIconProvider
                order="first"
                implementation="dev.knthmn.herdr.terminal.AgentFileIconProvider"/>
        <fileEditorProvider implementation="dev.knthmn.herdr.terminal.AgentTerminalEditorProvider"/>
        <applicationConfigurable
                parentId="tools"
                instance="dev.knthmn.herdr.settings.HerdrConfigurable"
                id="dev.knthmn.herdr.settings"
                displayName="Herdr"/>
    </extensions>
</idea-plugin>
