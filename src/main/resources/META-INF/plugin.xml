<idea-plugin>
    <id>dev.knthmn.herdr-session-manager</id>
    <name>Herdr Session Manager</name>
    <vendor url="https://github.com/knthmn/herdr-idea-plugin">knthmn</vendor>
    <description><![CDATA[
        <p>Lists the <a href="https://herdr.dev/core/">herdr-core</a> terminals of the open project in a sidebar and opens them in editor tabs.
        Coding agents such as Claude Code, Codex, pi and OpenCode show their status: blocked, error, unread, running or idle.</p>
        <ul>
            <li>Shows the terminals of the project folder, its git worktrees and extra folders.</li>
            <li>Shows child terminals under their parent, and finished terminals in a separate group.</li>
            <li>Starts, resumes, finishes and deletes sessions from the toolbar.</li>
            <li>Groups the rows by folder or worktree branch, and sorts them by recent change or by status.</li>
        </ul>
        <p>Needs herdr-core 0.1.16 or later. Settings | Tools | Herdr can install it.
        Resume, session titles and some blocked states need an agent integration that writes terminal labels.
        See the <a href="https://github.com/knthmn/herdr-idea-plugin#labels-and-agent-integrations">README</a>.</p>
        <p>This plugin is not affiliated with the herdr project.</p>
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
                id="Herdr"
                anchor="right"
                icon="/icons/herdr.svg"
                factoryClass="dev.knthmn.herdr.ui.HerdrToolWindowFactory"/>
        <fileIconProvider
                order="first"
                implementation="dev.knthmn.herdr.terminal.AgentFileIconProvider"/>
        <virtualFileSystem
                key="herdr"
                physical="false"
                implementationClass="dev.knthmn.herdr.terminal.HerdrFileSystem"/>
        <fileEditorProvider implementation="dev.knthmn.herdr.terminal.AgentTerminalEditorProvider"/>
        <editorTabTitleProvider implementation="dev.knthmn.herdr.terminal.AgentTabTitleProvider"/>
        <notificationGroup id="Herdr" displayType="BALLOON"/>
        <postStartupActivity implementation="dev.knthmn.herdr.startup.HerdrStartupActivity"/>
        <applicationConfigurable
                parentId="tools"
                instance="dev.knthmn.herdr.settings.HerdrConfigurable"
                id="dev.knthmn.herdr.settings"
                displayName="Herdr"/>
        <projectConfigurable
                parentId="dev.knthmn.herdr.settings"
                instance="dev.knthmn.herdr.settings.HerdrProjectConfigurable"
                id="dev.knthmn.herdr.settings.scope"
                displayName="Scope"
                nonDefaultProject="true"/>
    </extensions>

    <projectListeners>
        <listener
                class="dev.knthmn.herdr.ui.HerdrToolWindowListener"
                topic="com.intellij.openapi.wm.ex.ToolWindowManagerListener"/>
    </projectListeners>
</idea-plugin>
